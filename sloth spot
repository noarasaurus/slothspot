<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>sloth spot</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
:root{
  /* layout: one centered column. sloth mark + wordmark, search pill, result card with Apple and Spotify pills side by side, quiet history row */
  --bg:#f5f5f7; --surface:#ffffff; --ink:#1d1d1f; --muted:#6e6e73; --line:rgba(0,0,0,.08);
  --apple:#e11d38; --apple-2:#ff5c7a; --spot:#1ed760; --spot-ink:#04210f;
  --glow-a:rgba(250,36,60,.16); --glow-b:rgba(30,215,96,.16);
  --shadow:0 1px 2px rgba(0,0,0,.04),0 12px 40px rgba(0,0,0,.08);
  --font:"Heebo",-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",Arial,sans-serif;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#000; --surface:#1c1c1e; --ink:#f5f5f7; --muted:#98989d; --line:rgba(255,255,255,.1);
    --glow-a:rgba(250,36,60,.22); --glow-b:rgba(30,215,96,.18);
    --shadow:0 1px 2px rgba(0,0,0,.5),0 12px 40px rgba(0,0,0,.6);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#000; --surface:#1c1c1e; --ink:#f5f5f7; --muted:#98989d; --line:rgba(255,255,255,.1);
  --glow-a:rgba(250,36,60,.22); --glow-b:rgba(30,215,96,.18);
  --shadow:0 1px 2px rgba(0,0,0,.5),0 12px 40px rgba(0,0,0,.6);
  color-scheme:dark;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%}
body{
  font-family:var(--font); color:var(--ink); background-color:var(--bg);
  background-image:
    radial-gradient(60% 40% at 100% 0%,var(--glow-a),transparent 70%),
    radial-gradient(60% 40% at 0% 0%,var(--glow-b),transparent 70%);
  background-repeat:no-repeat;
  -webkit-font-smoothing:antialiased;
  padding:max(28px,env(safe-area-inset-top)) 16px max(32px,env(safe-area-inset-bottom));
}
main{max-width:460px;margin:0 auto;display:flex;flex-direction:column;gap:26px}

header{display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center}
.mark{width:68px;height:68px;border-radius:20px;background:linear-gradient(135deg,var(--apple) 0%,var(--apple-2) 40%,var(--spot) 100%);display:grid;place-items:center;box-shadow:0 8px 24px rgba(0,0,0,.14)}
.mark svg{width:56px;height:56px;display:block}
.word{margin:6px 0 0;font-size:36px;font-weight:800;letter-spacing:-.03em;line-height:1;direction:ltr}
.word .spot{background:linear-gradient(90deg,var(--apple),var(--spot));-webkit-background-clip:text;background-clip:text;color:transparent}
.tagline{margin:0;color:var(--muted);font-size:14px;max-width:300px;text-wrap:balance;direction:ltr}

.field{display:flex;align-items:center;gap:8px;background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:6px 6px 6px 8px;box-shadow:var(--shadow)}
.field:focus-within{outline:2px solid var(--apple);outline-offset:2px}
.field input{flex:1;min-width:0;border:0;background:transparent;color:var(--ink);font:inherit;font-size:16px;padding:12px 16px;outline:none;text-align:start}
.field input::placeholder{color:var(--muted)}
.go{border:0;border-radius:999px;background:var(--ink);color:var(--bg);font:inherit;font-weight:700;font-size:15px;padding:12px 20px;cursor:pointer;white-space:nowrap}
.go:hover{opacity:.88}
.go:focus-visible,.pill:focus-visible,.ghost:focus-visible,.tile:focus-visible,.link:focus-visible{outline:2px solid var(--apple);outline-offset:3px}

.card{background:var(--surface);border:1px solid var(--line);border-radius:28px;padding:20px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:18px}
.meta{display:flex;gap:16px;align-items:center}
.art{width:96px;height:96px;flex:none;border-radius:16px;overflow:hidden;background:linear-gradient(135deg,var(--apple),var(--apple-2) 45%,var(--spot));display:grid;place-items:center;box-shadow:0 6px 18px rgba(0,0,0,.18)}
.art img{width:100%;height:100%;object-fit:cover;display:block}
.art svg{width:36px;height:36px;fill:#fff;opacity:.9}
.txt{min-width:0}
.tag{display:inline-block;font-size:12px;font-weight:700;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:2px 10px;margin-bottom:6px}
.title{font-size:20px;font-weight:800;letter-spacing:-.01em;margin:0;overflow-wrap:anywhere}
.artist{margin:2px 0 0;color:var(--muted);font-size:16px;overflow-wrap:anywhere}

.pills{display:flex;gap:10px;flex-wrap:wrap}
.pill{flex:1 1 140px;display:flex;align-items:center;justify-content:center;gap:8px;border-radius:999px;padding:14px 12px;font-weight:700;font-size:16px;text-decoration:none;transition:transform .12s ease;text-align:center}
.pill:hover{transform:translateY(-1px)}
.pill:active{transform:scale(.99)}
.pill svg{width:22px;height:22px;flex:none}
.pill.apple{background:linear-gradient(135deg,var(--apple),var(--apple-2));color:#fff}
.pill.apple svg{fill:#fff}
.pill.spot{background:var(--spot);color:var(--spot-ink)}
.pill.spot svg{fill:var(--spot-ink)}
.pill.off{background:transparent;border:1px dashed var(--line);color:var(--muted);pointer-events:none;font-weight:500}
.pill.off svg{fill:var(--muted)}
.pill.off small{display:block;font-size:12px}

.actions{display:flex;gap:10px}
.send{flex:1.4;border:0;border-radius:999px;background:var(--ink);color:var(--bg);font:inherit;font-weight:700;font-size:16px;padding:14px 20px;cursor:pointer}
.send:hover{opacity:.88}
.ghost{flex:1;border:1px solid var(--line);background:transparent;color:var(--ink);border-radius:999px;font:inherit;font-weight:700;font-size:15px;padding:14px 16px;cursor:pointer}
.ghost:hover{background:var(--bg)}
.send:focus-visible{outline:2px solid var(--apple);outline-offset:3px}
.shareurl{direction:ltr;text-align:left;font-size:13px;color:var(--muted);background:var(--bg);border-radius:12px;padding:10px 12px;overflow-wrap:anywhere;user-select:all}

.results{list-style:none;margin:0;padding:6px;display:flex;flex-direction:column;background:var(--surface);border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow)}
.results button{all:unset;box-sizing:border-box;display:flex;align-items:center;gap:12px;padding:8px 10px;border-radius:18px;cursor:pointer;width:100%}
.results button:hover,.results button:focus-visible{background:var(--bg)}
.results button:focus-visible{outline:2px solid var(--apple)}
.results .thumb{width:48px;height:48px;border-radius:10px;flex:none;overflow:hidden;background:linear-gradient(135deg,var(--apple),var(--spot))}
.results .thumb img{width:100%;height:100%;object-fit:cover;display:block}
.results .rt{min-width:0;display:flex;flex-direction:column}
.results .rt b{font-weight:700;font-size:16px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.results .rt span{color:var(--muted);font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

.hist{display:flex;flex-direction:column;gap:10px}
.hist-head{display:flex;justify-content:space-between;align-items:center;font-size:13px;font-weight:700;color:var(--muted)}
.link{all:unset;cursor:pointer;font-weight:500;font-size:13px;color:var(--muted);text-decoration:underline;text-underline-offset:3px}
.link:focus-visible{outline:2px solid var(--apple);outline-offset:3px}
.hist-row{display:flex;gap:12px;overflow-x:auto;padding:2px 2px 6px;scrollbar-width:none}
.hist-row::-webkit-scrollbar{display:none}
.tile{all:unset;box-sizing:border-box;flex:none;width:76px;cursor:pointer;display:flex;flex-direction:column;gap:5px}
.tile:focus-visible{outline:2px solid var(--apple);outline-offset:3px;border-radius:14px}
.tile .th{width:76px;height:76px;border-radius:14px;overflow:hidden;background:linear-gradient(135deg,var(--apple),var(--apple-2) 45%,var(--spot));box-shadow:0 4px 12px rgba(0,0,0,.12)}
.tile .th img{width:100%;height:100%;object-fit:cover;display:block}
.tile b{font-size:12px;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tile span{font-size:11px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

.msg{border-radius:20px;padding:16px 18px;font-size:15px;line-height:1.5}
.msg.err{background:rgba(225,29,56,.1);color:var(--apple)}
.msg.load{color:var(--muted);text-align:center}
[hidden]{display:none!important}
@media (prefers-reduced-motion:reduce){.pill{transition:none}}
</style>
</head>
<body>
<main>
  <header>
    <span class="mark" aria-hidden="true">
      <svg viewBox="0 0 64 64" fill="none">
        <ellipse cx="32" cy="36" rx="23" ry="20" fill="#efe2cc"/>
        <path d="M13 28c4-11 12-15 19-15s15 4 19 15c-6-5-12-7-19-7s-13 2-19 7z" fill="#b99a74"/>
        <ellipse cx="21" cy="35" rx="7" ry="5" transform="rotate(25 21 35)" fill="#6b5240"/>
        <ellipse cx="43" cy="35" rx="7" ry="5" transform="rotate(-25 43 35)" fill="#6b5240"/>
        <path d="M17.5 35q3.5 3 7 0M39.5 35q3.5 3 7 0" stroke="#efe2cc" stroke-width="2.2" stroke-linecap="round"/>
        <ellipse cx="32" cy="42" rx="3" ry="2.2" fill="#3b2c22"/>
        <path d="M27 47q5 4 10 0" stroke="#3b2c22" stroke-width="2" stroke-linecap="round"/>
        <path d="M49 8h7l-7 8h7" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <h1 class="word">sloth <span class="spot">spot</span></h1>
    <p class="tagline" lang="en">for friends who are too lazy to send the right link</p>
  </header>

  <form id="form" class="field" autocomplete="off">
    <input id="url" type="text" inputmode="search" placeholder="שם שיר או קישור" aria-label="חיפוש שיר או קישור" spellcheck="false">
    <button class="go" type="submit">יאללה</button>
  </form>

  <section id="out" aria-live="polite">
    <div class="card" id="sample">
      <div class="meta">
        <div class="art"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V6l11-2v12.2a3 3 0 1 1-2-2.8V7.6L11 8.8V18a3 3 0 1 1-2-2.8z"/></svg></div>
        <div class="txt">
          <span class="tag">דוגמה</span>
          <p class="title">שם השיר</p>
          <p class="artist">שם האמן</p>
        </div>
      </div>
      <div class="pills">
        <a class="pill apple" href="https://music.apple.com/" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V6l11-2v12.2a3 3 0 1 1-2-2.8V7.6L11 8.8V18a3 3 0 1 1-2-2.8z"/></svg>אפל מיוזיק</a>
        <a class="pill spot" href="https://open.spotify.com/" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1.5a10.5 10.5 0 1 0 0 21 10.5 10.5 0 0 0 0-21zm4.8 15.1a.8.8 0 0 1-1.1.3c-3-1.8-6.7-2.2-11.1-1.2a.8.8 0 1 1-.35-1.55c4.8-1.1 8.9-.6 12.2 1.4.4.2.5.7.35 1.05zm1.3-2.9a1 1 0 0 1-1.4.35c-3.4-2.1-8.5-2.7-12.5-1.5a1 1 0 1 1-.6-1.9c4.6-1.4 10.2-.7 14.1 1.7.5.3.6.9.4 1.35zm.1-3c-4-2.4-10.6-2.6-14.4-1.5a1.2 1.2 0 1 1-.7-2.3c4.4-1.3 11.7-1.1 16.3 1.7a1.2 1.2 0 0 1-1.2 2.1z"/></svg>ספוטיפיי</a>
      </div>
    </div>
  </section>

  <section class="hist" id="hist" hidden aria-label="היסטוריה">
    <div class="hist-head"><span>הומרו לאחרונה</span><button class="link" id="clear" type="button">נקה</button></div>
    <div class="hist-row" id="histrow"></div>
  </section>
</main>

<script>
(function(){
  var API = "https://api.song.link/v1-alpha.1/links?userCountry=IL&url=";
  var HK = "slothspot.history";
  var form = document.getElementById("form");
  var input = document.getElementById("url");
  var out = document.getElementById("out");
  var hist = document.getElementById("hist");
  var histrow = document.getElementById("histrow");
  var NOTE = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V6l11-2v12.2a3 3 0 1 1-2-2.8V7.6L11 8.8V18a3 3 0 1 1-2-2.8z"/></svg>';
  var SPOT = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1.5a10.5 10.5 0 1 0 0 21 10.5 10.5 0 0 0 0-21zm4.8 15.1a.8.8 0 0 1-1.1.3c-3-1.8-6.7-2.2-11.1-1.2a.8.8 0 1 1-.35-1.55c4.8-1.1 8.9-.6 12.2 1.4.4.2.5.7.35 1.05zm1.3-2.9a1 1 0 0 1-1.4.35c-3.4-2.1-8.5-2.7-12.5-1.5a1 1 0 1 1-.6-1.9c4.6-1.4 10.2-.7 14.1 1.7.5.3.6.9.4 1.35zm.1-3c-4-2.4-10.6-2.6-14.4-1.5a1.2 1.2 0 1 1-.7-2.3c4.4-1.3 11.7-1.1 16.3 1.7a1.2 1.2 0 0 1-1.2 2.1z"/></svg>';

  function esc(s){ return String(s == null ? "" : s).replace(/[&<>"']/g, function(c){
    return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]; }); }
  function safeUrl(u){ return /^https:\/\//.test(u || "") ? u : ""; }
  function isMobile(){ return /Mobi|Android|iPhone|iPad/.test(navigator.userAgent); }

  function shareLink(orig){
    var base = location.origin && location.origin !== "null" ? location.origin + location.pathname : "";
    return base ? base + "?u=" + encodeURIComponent(orig) : "";
  }
  function show(html){ out.innerHTML = html; }
  function showErr(t){ show('<div class="msg err">' + esc(t) + '</div>'); }

  /* היסטוריה קטנה, נשמרת רק במכשיר הזה */
  function loadH(){ try { return JSON.parse(localStorage.getItem(HK) || "[]"); } catch(e){ return []; } }
  function saveH(item){
    try {
      var h = loadH().filter(function(x){ return !(x.t === item.t && x.a === item.a); });
      h.unshift(item);
      localStorage.setItem(HK, JSON.stringify(h.slice(0, 10)));
    } catch(e){}
    drawH();
  }
  function drawH(){
    var h = loadH();
    if (!h.length){ hist.hidden = true; return; }
    hist.hidden = false;
    histrow.innerHTML = h.map(function(x, i){
      var a = safeUrl(x.i);
      return '<button class="tile" type="button" data-h="' + i + '"><span class="th">' + (a ? '<img src="' + esc(a) + '" alt="">' : "") + '</span><b>' + esc(x.t) + '</b><span>' + esc(x.a) + '</span></button>';
    }).join("");
    histrow.querySelectorAll("button[data-h]").forEach(function(b){
      b.addEventListener("click", function(){
        var x = h[+b.getAttribute("data-h")];
        if (x && x.u){ input.value = x.u; run(x.u); window.scrollTo({ top: 0, behavior: "smooth" }); }
      });
    });
  }
  document.getElementById("clear").addEventListener("click", function(){
    try { localStorage.removeItem(HK); } catch(e){}
    drawH();
  });

  function pill(kind, url, label, icon){
    var u = safeUrl(url);
    if (!u) return '<span class="pill ' + kind + ' off">' + icon + '<span>' + esc(label) + '<small>לא נמצא</small></span></span>';
    return '<a class="pill ' + kind + '" href="' + esc(u) + '" rel="noopener">' + icon + esc(label) + '</a>';
  }

  function render(data, orig){
    var ent = (data.entitiesByUniqueId || {})[data.entityUniqueId] || {};
    var links = data.linksByPlatform || {};
    var art = safeUrl(ent.thumbnailUrl);
    var kind = ent.type === "album" ? "אלבום" : "שיר";
    var share = shareLink(orig);
    var html = '<div class="card">' +
      '<div class="meta"><div class="art">' + (art ? '<img src="' + esc(art) + '" alt="" id="artimg">' : NOTE) + '</div>' +
      '<div class="txt"><span class="tag">' + kind + '</span><p class="title">' + esc(ent.title || "") + '</p><p class="artist">' + esc(ent.artistName || "") + '</p></div></div>' +
      '<div class="pills">' +
        pill("apple", (links.appleMusic || {}).url, "אפל מיוזיק", NOTE) +
        pill("spot", (links.spotify || {}).url, "ספוטיפיי", SPOT) +
      '</div>' +
      '<div class="actions"><button class="send" id="send" type="button">שלחי לחברה</button>' +
      '<button class="ghost" id="copy" type="button">העתקת קישור</button></div>' +
    '</div>';
    show(html);
    var img = document.getElementById("artimg");
    if (img) img.addEventListener("error", function(){ img.parentNode.innerHTML = NOTE; });
    var link = share || orig;
    var label = (ent.title || "") + (ent.artistName ? " – " + ent.artistName : "");
    document.getElementById("send").addEventListener("click", function(){ sendToFriend(label, link); });
    var btn = document.getElementById("copy");
    btn.addEventListener("click", function(){ copy(link, btn); });
    if (ent.title) saveH({ t: ent.title, a: ent.artistName || "", i: art, u: orig });
  }

  function sendToFriend(label, link){
    if (navigator.share && isMobile()){
      navigator.share({ title: label, text: label, url: link }).catch(function(){});
      return;
    }
    var w = "https://wa.me/?text=" + encodeURIComponent(label + "\n" + link);
    var a = document.createElement("a");
    a.href = w; a.target = "_blank"; a.rel = "noopener";
    document.body.appendChild(a); a.click(); a.remove();
  }

  function copy(text, btn){
    var reset = function(){ setTimeout(function(){ btn.textContent = "העתקת קישור"; }, 1800); };
    var done = function(){ btn.textContent = "הועתק"; reset(); };
    var fallback = function(){
      var d = document.createElement("div");
      d.className = "shareurl"; d.textContent = text;
      btn.parentNode.parentNode.appendChild(d);
      var r = document.createRange(); r.selectNodeContents(d);
      var s = getSelection(); s.removeAllRanges(); s.addRange(r);
      btn.textContent = "סמנו והעתיקו";
    };
    if (navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(text).then(done, fallback);
    } else { fallback(); }
  }

  var seq = 0;
  function run(raw){
    var url = (raw || "").trim();
    if (!url) return;
    if (!/^https?:\/\//i.test(url)) url = "https://" + url;
    var my = ++seq;
    show('<div class="msg load">מחפש את השיר…</div>');
    var ctl = ("AbortController" in window) ? new AbortController() : null;
    var timer = setTimeout(function(){ if (ctl) ctl.abort(); }, 15000);
    fetch(API + encodeURIComponent(url), ctl ? { signal: ctl.signal } : {})
      .then(function(r){
        if (r.status === 429) throw new Error("rate");
        if (!r.ok) throw new Error("notfound");
        return r.json();
      })
      .then(function(d){ if (my === seq) render(d, url); })
      .catch(function(e){
        if (my !== seq) return;
        if (e.message === "rate") showErr("יותר מדי בקשות. נסו שוב בעוד דקה.");
        else if (e.message === "notfound") showErr("לא מצאתי את השיר. בדקו שהקישור הוא לשיר או אלבום באפל מיוזיק או בספוטיפיי.");
        else showErr("אין חיבור לשירות ההמרה. נסו שוב בעוד רגע.");
      })
      .then(function(){ clearTimeout(timer); });
  }

  var isLink = function(s){ return /^https?:\/\//i.test(s) || /(music\.apple|spotify|itunes\.apple|song\.link)/i.test(s); };

  /* חיפוש לפי שם: iTunes Search (חינמי, בלי מפתח), ואז Odesli משלים את ספוטיפיי */
  var sseq = 0, stimer = null;
  function search(term){
    var my = ++sseq;
    show('<div class="msg load">מחפש…</div>');
    fetch("https://itunes.apple.com/search?media=music&entity=song&limit=6&country=IL&term=" + encodeURIComponent(term))
      .then(function(r){ if (!r.ok) throw new Error("x"); return r.json(); })
      .then(function(d){
        if (my !== sseq) return;
        var rs = (d.results || []).filter(function(t){ return t.trackViewUrl; });
        if (!rs.length){ showErr("לא נמצא שיר בשם הזה. נסו להוסיף את שם האמן."); return; }
        var html = '<ul class="results">';
        rs.forEach(function(t, i){
          var a = safeUrl((t.artworkUrl100 || "").replace("100x100", "200x200"));
          html += '<li><button type="button" data-i="' + i + '"><span class="thumb">' + (a ? '<img src="' + esc(a) + '" alt="">' : "") + '</span>' +
                  '<span class="rt"><b>' + esc(t.trackName) + '</b><span>' + esc(t.artistName) + '</span></span></button></li>';
        });
        html += "</ul>";
        show(html);
        out.querySelectorAll("button[data-i]").forEach(function(b){
          b.addEventListener("click", function(){
            var url = rs[+b.getAttribute("data-i")].trackViewUrl;
            input.value = url; run(url);
          });
        });
      })
      .catch(function(){ if (my === sseq) showErr("החיפוש לא זמין כרגע. נסו שוב או הדביקו קישור."); });
  }

  form.addEventListener("submit", function(e){
    e.preventDefault();
    var v = input.value.trim();
    if (!v) return;
    if (isLink(v)) run(v); else search(v);
  });
  input.addEventListener("input", function(){
    clearTimeout(stimer);
    var v = input.value.trim();
    if (!v || isLink(v) || v.length < 2) return;
    stimer = setTimeout(function(){ search(v); }, 400);
  });
  input.addEventListener("paste", function(){
    setTimeout(function(){ if (isLink(input.value.trim())) { clearTimeout(stimer); run(input.value); } }, 0);
  });

  drawH();
  var q = /[?&]u=([^&]+)/.exec(location.search);
  if (q){
    try { var u0 = decodeURIComponent(q[1]); input.value = u0; run(u0); } catch(e){}
  }
})();
</script>
